{
  "name": "connection-dot",
  "version": "1.0.0",
  "description": "Internet status in the GNOME top bar",
  "scripts": {
    "build": "npm run clean && tsc && python3 scripts/package.py",
    "build:dev": "npm run clean && tsc --sourceMap && python3 scripts/package.py --dev",
    "check": "tsc --noEmit",
    "test": "tsc && node --test --test-isolation=none tests/*.test.mjs && gjs -m tests/endpoint.gjs.mjs",
    "pack": "npm run build",
    "verify:package": "python3 scripts/verify.py",
    "dev": "tsc --watch --sourceMap",
    "install:dev": "npm run build:dev && gnome-extensions install --force artifacts/connection-dot-dev.shell-extension.zip",
    "uninstall:dev": "gnome-extensions uninstall connection-dot-dev@derrick-nuby.github.io",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "install:prod": "npm run pack && gnome-extensions install --force artifacts/connection-dot.shell-extension.zip"
  },
  "keywords": [
    "gnome-shell-extension",
    "internet",
    "connectivity"
  ],
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@girs/gjs": "^4.0.0-beta.34",
    "@girs/gnome-shell": "^48.0.4",
    "@girs/soup-3.0": "^5.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@girs/accountsservice-1.0": "1.0.0-4.0.0-beta.34",
    "@girs/adw-1": "^1.8.0-4.0.0-beta.34",
    "@girs/atk-1.0": "^2.56.3-4.0.0-beta.34",
    "@girs/clutter-16": "^16.0.0-4.0.0-beta.34",
    "@girs/cogl-2.0": "^2.0.0-4.0.0-beta.34",
    "@girs/gcr-4": "^4.4.0-4.0.0-beta.34",
    "@girs/gdm-1.0": "^1.0.0-4.0.0-beta.34",
    "@girs/gio-2.0": "^2.84.4-4.0.0-beta.34",
    "@girs/gjs": "^4.0.0-beta.34",
    "@girs/glib-2.0": "^2.84.4-4.0.0-beta.34",
    "@girs/gnomebg-4.0": "^4.0.0-4.0.0-beta.34",
    "@girs/gnomebluetooth-3.0": "^3.0.0-4.0.0-beta.34",
    "@girs/gnomedesktop-4.0": "^4.0.0-4.0.0-beta.34",
    "@girs/gobject-2.0": "^2.84.4-4.0.0-beta.34",
    "@girs/gtk-4.0": "^4.19.1-4.0.0-beta.34",
    "@girs/gvc-1.0": "^1.0.0-4.0.0-beta.34",
    "@girs/meta-16": "^16.0.0-4.0.0-beta.34",
    "@girs/mtk-16": "^16.0.0-4.0.0-beta.34",
    "@girs/polkit-1.0": "^1.0.0-4.0.0-beta.34",
    "@girs/shell-16": "^16.0.0-4.0.0-beta.34",
    "@girs/shew-0": "^0.0.0-4.0.0-beta.34",
    "@girs/st-16": "^16.0.0-4.0.0-beta.34",
    "@girs/upowerglib-1.0": "^0.99.1-4.0.0-beta.34"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/derrick-nuby/connection-dot.git"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
